[rendering]

renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.02, 0.02, 0.04, 1)
renderer/anti_aliasing/quality/msaa=2
renderer/anti_aliasing/quality/screen_space_aa=2
renderer/shadow_atlas/size/subdiv_0=1024
renderer/shadow_atlas/size/subdiv_1=2048
renderer/shadows/soft_shadow_filter_quality=2
renderer/occlusion_culling/use_occlusion=true
renderer/culling/occlusion_rays_per_pixel=4
renderer/2d/snap/snap_2d_transforms_to_pixel=true
renderer/2d/snap/snap_2d_vertices_to_pixel=true
renderer/2d/use_pixel_snap=true
vram_compression/import_compression_level=0
vram_compression/import_s3tc_bptc=true
renderer/2d/opengl/legacy_smoothing=true
renderer/2d/opengl/legacy_snap_2d=true
